rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Gate: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMainAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'MainAdmin';
    }

    function isTenantOwner(tenantId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToTenant(tenantId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().tenantId == tenantId) || isMainAdmin()
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.firstName is string && data.firstName.size() <= 50
        && data.surname is string && data.surname.size() <= 50;
    }

    function isValidGig(data) {
      return data.keys().hasAll(['title', 'location', 'category'])
        && data.title is string && data.title.size() <= 100
        && data.category in ['Live Music', 'Tech & Dev', 'Design', 'Production', 'Events'];
    }

    function isValidTenant(data) {
      return data.keys().hasAll(['name', 'slug', 'subdomain', 'status'])
        && data.slug is string && data.slug.size() >= 3
        && data.subdomain == data.slug + '.timegig.com'
        && data.status in ['active', 'expired', 'suspended'];
    }

    function isValidTenantSettings(data, userId) {
      return data.tenantId is string && (data.tenantId == userId || isMainAdmin())
        && (!('appName' in data) || (data.appName is string && data.appName.size() <= 100))
        && (!('slug' in data) || (data.slug is string && data.slug.size() <= 100))
        && (!('subscriptionFee' in data) || (data.subscriptionFee is string && data.subscriptionFee.size() <= 50))
        && (!('displayLogo5s' in data) || data.displayLogo5s is bool)
        && (!('appLogo' in data) || data.appLogo == null || (data.appLogo is string && data.appLogo.size() <= 1000000));
    }

    // --- Collections ---

    match /_connection_test_/{id} {
      allow read: if true;
    }

    match /tenants/{tenantId} {
      allow read: if true; // Public for branding resolution
      allow create: if isMainAdmin() && isValidTenant(incoming());
      allow update: if isMainAdmin();
      allow update: if isTenantOwner(tenantId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'logoUrl', 'primaryColor', 'secondaryColor', 'displayLogo5s', 'updatedAt']);
      allow delete: if isMainAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isMainAdmin() || (isSignedIn() && resource.data.tenantId == request.auth.uid);
      allow create: if isSignedIn() && userId == request.auth.uid && (
        !incoming().keys().contains('tenantId') || 
        incoming().tenantId == null || 
        exists(/databases/$(database)/documents/tenants/$(incoming().tenantId))
      );
      allow update: if isOwner(userId) && 
        (!incoming().diff(existing()).affectedKeys().hasAny(['accountType', 'tenantId']) || 
         (incoming().accountType == existing().accountType && incoming().tenantId == existing().tenantId) ||
         isMainAdmin());
      allow update: if isMainAdmin();
    }

    match /tenantSettings/{userId} {
      allow get: if isOwner(userId) || isMainAdmin();
      allow list: if isMainAdmin();
      allow create, update: if (isOwner(userId) || isMainAdmin()) && isValidTenantSettings(incoming(), userId);
      allow delete: if isOwner(userId) || isMainAdmin();
    }

    match /gigs/{gigId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        !incoming().keys().contains('tenantId') || 
        belongsToTenant(incoming().tenantId)
      );
      allow update: if isSignedIn() && (
        isOwner(existing().createdBy) || 
        isMainAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['applied', 'saved'])
      );
      allow delete: if isMainAdmin() || isOwner(existing().createdBy);
    }

    match /seekers/{seekerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        !incoming().keys().contains('tenantId') || 
        belongsToTenant(incoming().tenantId)
      );
      allow update: if isSignedIn() && (
        isOwner(existing().uid) || 
        isMainAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['hired'])
      );
      allow delete: if isMainAdmin();
    }
  }
}
