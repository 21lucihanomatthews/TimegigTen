rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Gate: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'firstName', 'surname', 'accountType'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 100
        && data.firstName is string && data.firstName.size() <= 50
        && data.surname is string && data.surname.size() <= 50
        && data.accountType in ['User', 'Tenant'];
    }

    function isValidGig(data) {
      return data.keys().hasAll(['title', 'location', 'category', 'createdBy'])
        && data.createdBy == request.auth.uid
        && data.title is string && data.title.size() <= 100
        && data.category in ['Live Music', 'Tech & Dev', 'Design', 'Production', 'Events'];
    }

    function isValidSeeker(data) {
      return data.keys().hasAll(['name', 'trade', 'uid'])
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100;
    }

    function isValidTenantSettings(data, tenantId) {
      return data.keys().hasAll(['tenantId'])
        && data.tenantId == request.auth.uid
        && tenantId == request.auth.uid;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn(); // Allow reading profiles for interactions
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming()) && userId == request.auth.uid;
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'firstName', 'middleName', 'surname', 'dob', 'address', 'city', 'province', 
          'contactNumber', 'socialLinks', 'facePhotoUrl', 'idDocumentName', 'accountType', 'isTenantApproved', 'updatedAt'
        ]);
    }

    match /gigs/{gigId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidGig(incoming());
      allow update: if isSignedIn() && (
        // Creator update
        (existing().createdBy == request.auth.uid && isValidGig(incoming())) ||
        // Interaction update (apply/save) - ideally subcollection, but if in main doc:
        (incoming().diff(existing()).affectedKeys().hasOnly(['applied', 'saved']))
      );
      allow delete: if isSignedIn() && existing().createdBy == request.auth.uid;
    }

    match /seekers/{seekerId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidSeeker(incoming());
      allow update: if isOwner(existing().uid) && isValidSeeker(incoming());
    }

    match /tenantSettings/{tenantId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(tenantId) && isValidTenantSettings(incoming(), tenantId);
    }
  }
}
